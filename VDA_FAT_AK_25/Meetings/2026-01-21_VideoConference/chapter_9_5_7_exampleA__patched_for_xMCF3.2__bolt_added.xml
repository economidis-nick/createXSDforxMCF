<?xml version="1.0" encoding="iso-8859-1" standalone="no"?>
<xmcf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="xmcf_3_2.xsd">
	<date> 2026-01-25 </date>
	<version> 3.2 CF </version>
	<units length="mm" angle="rad" mass="kg" force="N" time="s"/>

<!-- Add examples for spot_welds! -->

	<connection_templates>
	
			<connection_0d label="screw_catalog_item_4711">
				<threaded_connection length="50." diameter="10" 
					head_diameter="16.0" head_height="5" sink_size="4" thread_length="35" 
					torque="80" angle="30" pretension="1200" part_code="M10x50 12.9" >
					<screw /> <!-- Screw may come without any attributes --> 
					<washer outer_diameter="20"/>
				</threaded_connection>
			</connection_0d>

			<connection_0d label="bolt_catalog_item_4712"> 
    			<threaded_connection length="50" diameter="10" head_diameter="16" head_height="5" thread_length="35" 
                                     torque="80" angle="30" pretension="1200" part_code="M10x50 12.9"> 
					<normal_direction x="0" y="0" z="-10"/> 
					<washer outer_diameter="20" inner_diameter="10.3" thickness="1.5" attached="true"/> 
					<bolt> 
						<nut diameter="16." height="5" static_friction="0.8" clipped_to="4"/>
					</bolt> 
     			</threaded_connection> 
			</connection_0d>

	</connection_templates>

	<connection_group id="1">
		<connected_to>
			<part index="1" label="PART_7000400"/>
			<part index="2" label="PART_7100100"/>
			<part index="5" label="PART_5000300"/>
			<part index="6" label="PART_5000800"/>
		</connected_to>
		<connection_list>
			<connection_0d label="SCREW_100532">
			    <!-- Screw exactly as defined in connection_templates: -->
				<threaded_connection template="screw_catalog_item_4711">
					<normal_direction x="2.9" y="0.1" z="0.0" /> 
				</threaded_connection>
				<loc> 1500.3809 838.75885 730.6529 </loc>
			</connection_0d>
			<connection_0d label="SCREW_100533">
			    <!-- Screw exactly as defined in connection_templates, but with smaller torque: -->
				<threaded_connection template="screw_catalog_item_4711" torque="70" >
					<normal_direction x="3.0" y="0.0" z="0.0" /> 
				</threaded_connection>
				<loc> 1540.3809 838.75885 730.6529 </loc>
			</connection_0d>
		</connection_list>
	</connection_group>
	<connection_group id="101">
		<connected_to>
			<part index="1" label="PART_8000400"/>
			<part index="2" label="PART_8100100"/>
			<part index="5" label="PART_6000300"/>
			<part index="6" label="PART_6000800"/>
		</connected_to>
		<connection_list>
			<connection_0d label="SCREW_101537">
			    <!-- Screw exactly as defined in connection_templates, but with larger washer: -->
				<threaded_connection template="screw_catalog_item_4711">
					<normal_direction x="3.1" y="-0.1" z="0.0" /> 
					<washer outer_diameter="30"/>
				</threaded_connection>
				<loc> 1580.3809 838.75885 730.6529 </loc>
			</connection_0d>

			<connection_0d label="BOLT_100732">
    			<!-- Bolt exactly as defined in connection_templates, but with less torque, larger washer & nut: -->
    			<threaded_connection template="bolt_catalog_item_4712" torque="70">
        			<normal_direction x="3.1" y="-0.1" z="0.0"/> 
        			<washer outer_diameter="30"/> 
        			<bolt> 
            			<nut height="8"/>
        			</bolt> 
    			</threaded_connection>
			</connection_0d>

		</connection_list>
	</connection_group>
</xmcf>
